{#- ROAR 2.0 email template.
    Every style is inline and colours are repeated as bgcolor attributes: Gmail drops <style> blocks, so
    nothing here may depend on a class. Layout uses tables for the parts that need boxes (header band,
    editor's note, section bars, numbered badges); text runs in plain divs. -#}
{%- set FONT = "font-family:Helvetica,Arial,sans-serif;" -%}
{%- set NAVY = "#0f2440" -%}
{%- set TAG = "font-size:11px;color:#1f4f6e;background-color:#e8f1f8;border-radius:10px;padding:2px 8px" -%}
{%- set META = "font-size:12px;line-height:1.4;color:#66748a;margin-top:4px" -%}
{%- set SUM = "margin-top:6px" -%}
{%- set LK = "font-size:12px;margin-top:6px" -%}
{%- macro section_bar(label, accent, tint, big=False) -%}
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:{{ '26px' if big else '22px' }}">
<tr>
<td width="6" bgcolor="{{ accent }}" style="width:6px;background-color:{{ accent }};font-size:0">&nbsp;</td>
<td bgcolor="{{ tint }}" style="background-color:{{ tint }};padding:8px 14px;{{ FONT }}font-size:12px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:{{ NAVY }}">{{ label }}</td>
</tr>
</table>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — week of {{ week_label }}</title>
</head>
<body style="margin:0;padding:0;background-color:#eef1f5;{{ FONT }}color:#1c2430;" bgcolor="#eef1f5">
<span style="display:none;max-height:0;overflow:hidden;color:#eef1f5;font-size:1px;line-height:1px;">{{ preheader }}</span>
<table width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#eef1f5" style="background-color:#eef1f5;"><tr><td align="center" style="padding:24px 12px;">
<table width="660" cellpadding="0" cellspacing="0" border="0" bgcolor="#fff" style="max-width:660px;width:100%;background-color:#fff;border-radius:10px;">
<tr><td bgcolor="{{ NAVY }}" style="background-color:{{ NAVY }};color:#fff;padding:26px 30px 22px 30px;border-radius:10px 10px 0 0;{{ FONT }}">
<div style="font-size:30px;font-weight:800;letter-spacing:.5px;line-height:1.1;color:#fff;"><span style="color:#f5a54a;">ROAR</span> 2.0</div>
<div style="font-size:13px;color:#b8c4d6;margin-top:4px;">{{ subtitle }}</div>
<div style="font-size:15px;color:#fff;margin-top:14px;font-weight:600;">Week of {{ week_label }}</div>
<div style="font-size:12px;color:#b8c4d6;margin-top:4px;">{{ stats_line }}</div>
</td></tr>
<tr><td style="padding:14px 30px 4px 30px;{{ FONT }}font-size:14px;line-height:1.55;color:#2b3645">
{% if editor_note %}
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:8px;">
<tr>
<td width="5" bgcolor="#f5a54a" style="width:5px;background-color:#f5a54a;font-size:0;line-height:0;">&nbsp;</td>
<td bgcolor="#fff7ec" style="background-color:#fff7ec;padding:12px 16px;{{ FONT }}font-size:14px;line-height:1.55;color:#2b3645;"><b style="color:{{ NAVY }};">Editor's note.</b> {{ editor_note }}</td>
</tr>
</table>
{% endif %}
{% if top_picks %}
{{ section_bar("This week's top picks", colors["top"][0], colors["top"][1], big=True) }}
{% for p in top_picks %}
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:18px;">
<tr>
<td width="30" valign="top" style="width:30px;padding:2px 12px 0 0"><table cellpadding="0" cellspacing="0" border="0"><tr><td width="28" height="28" align="center" bgcolor="{{ NAVY }}" style="width:28px;height:28px;background-color:{{ NAVY }};border-radius:14px;{{ FONT }}font-size:13px;font-weight:700;color:#fff;line-height:28px">{{ loop.index }}</td></tr></table></td>
<td valign="top" style="{{ FONT }}font-size:19px;font-weight:700;line-height:1.3"><a href="{{ p.article_url }}" style="color:{{ NAVY }};text-decoration:none">{{ p.headline }}</a></td>
</tr>
</table>
<div style="padding-left:42px">
<div style="{{ META }}">{{ p.meta }}</div>
{% if p.tags %}<div style="margin-top:7px;line-height:2">{% for t in p.tags %}<span style="{{ TAG }}">{{ t }}</span>{% if not loop.last %}&nbsp; {% endif %}{% endfor %}</div>{% endif %}
<div style="{{ SUM }}">{{ p.summary }}</div>
{% if p.why_it_matters %}<div style="font-size:13px;margin-top:6px"><b style="color:#b8641b">Why it matters:</b> {{ p.why_it_matters }}</div>{% endif %}
<div style="{{ LK }}">{{ p.links_html | safe }}</div>
</div>
{% endfor %}
{% endif %}
{% for sec in sections %}
{{ section_bar(sec.label, sec.accent, sec.tint) }}
{% for p in sec.entries %}
{% if sec.compact %}
<div style="margin-top:12px"><a href="{{ p.article_url }}" style="color:{{ NAVY }};text-decoration:none;font-weight:700;font-size:15px">{{ p.headline }}</a> <span style="color:#66748a;font-size:12px">— {{ p.meta_short }}</span><br>{{ p.summary }} <span style="font-size:12px">{{ p.links_html | safe }}</span></div>
{% else %}
<div style="margin-top:16px">
<div style="font-size:17px;font-weight:700;line-height:1.3"><a href="{{ p.article_url }}" style="color:{{ NAVY }};text-decoration:none">{{ p.headline }}</a></div>
<div style="{{ META }}">{{ p.meta }}{% if p.tags %} · {{ p.tags | join(' · ') }}{% endif %}</div>
<div style="{{ SUM }}">{{ p.summary }}{% if p.why_it_matters %} <span style="color:#5c6b80">{{ p.why_it_matters }}</span>{% endif %}</div>
<div style="{{ LK }}">{{ p.links_html | safe }}</div>
</div>
{% endif %}
{% endfor %}
{% endfor %}
{% if conferences %}
{{ section_bar("Coming up", colors["conferences"][0], colors["conferences"][1]) }}
<div style="font-size:13px;line-height:1.8;margin-top:10px">{% for c in conferences %}<a href="{{ c.url }}" style="color:{{ NAVY }};font-weight:600;text-decoration:none;">{{ c.name }}</a> — {{ c.when }}, {{ c.location }}{% if c.days_away %} <span style="color:#66748a;">({{ c.days_away }})</span>{% endif %}<br>{% endfor %}</div>
{% endif %}
<div style="border-top:1px solid #e3e8ef;padding-top:14px;margin-top:24px;font-size:11px;line-height:1.6;color:#7a879a;">
{{ footer_line }}{% if skipped_summary %}<br>Not shown: {{ skipped_summary }}{% endif %}
<br>Links: <b>Article</b> opens the publisher page, <b>PubMed</b> the abstract, <b>U-M</b> the full text through the University of Michigan library proxy (log in with your uniqname).
<br>ROAR 2.0 is a personal open-source tool; sources and interests live in the repo's config/ folder.
</div>
<div style="height:20px;line-height:20px;font-size:0;">&nbsp;</div>
</td></tr>
</table>
</td></tr></table>
</body>
</html>
