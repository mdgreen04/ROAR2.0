# Who receives the digest (overrides settings.yaml)
ROAR_TO=you@gmail.com
# Contact address for NCBI E-utilities
ROAR_NCBI_EMAIL=you@gmail.com
# Copy to .env (never commit .env). All values optional depending on how you run ROAR.

# --- Email via Gmail SMTP (work computer / GitHub Actions). Create an App Password at
#     https://myaccount.google.com/apppasswords (requires 2-step verification on the Google account).
ROAR_SMTP_USER=you@gmail.com
ROAR_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
ROAR_FROM=you@gmail.com

# --- Claude API (only for `--backend anthropic`). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Optional: NCBI API key raises the PubMed rate limit from 3 to 10 requests/second.
NCBI_API_KEY=
